<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="krs_mahasiswa"
              pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="NIM" class="java.lang.String"/>
    <parameter name="NAMA" class="java.lang.String"/>
    <parameter name="PRODI" class="java.lang.String"/>
    <parameter name="TAHUN_AKADEMIK" class="java.lang.String"/>
    <parameter name="NIM_PARAM" class="java.lang.String"/>
    <parameter name="TAHUN_ID_PARAM" class="java.lang.Integer"/>

    <queryString>
        <![CDATA[
        SELECT mk.kode_mk, mk.nama_mk, mk.sks, IFNULL(d.nama_lengkap, '-') AS dosen
        FROM krs_detail kd 
        JOIN jadwal j ON kd.jadwal_id = j.jadwal_id 
        JOIN kelas k ON j.kelas_id = k.kelas_id 
        JOIN mata_kuliah mk ON k.mk_id = mk.mk_id 
        LEFT JOIN dosen d ON k.nip = d.nip 
        WHERE kd.status = 'Approved' AND kd.krs_id IN 
        (SELECT krs_id FROM krs WHERE nim = $P{NIM_PARAM} AND tahun_id = $P{TAHUN_ID_PARAM})
        ORDER BY mk.kode_mk
        ]]>
    </queryString>

    <field name="kode_mk" class="java.lang.String"/>
    <field name="nama_mk" class="java.lang.String"/>
    <field name="sks" class="java.lang.Integer"/>
    <field name="dosen" class="java.lang.String"/>

    <variable name="ROW_NUM" class="java.lang.Integer" resetType="Report" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <variable name="TOTAL_SKS" class="java.lang.Integer" resetType="Report" calculation="Sum">
        <variableExpression><![CDATA[$F{sks}]]></variableExpression>
    </variable>

    <title>
        <band height="120">
            <staticText>
                <reportElement x="0" y="0" width="555" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[KARTU RENCANA STUDI (KRS)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="25" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Tahun Akademik: " + $P{TAHUN_AKADEMIK}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="2.0"/>
                </graphicElement>
            </line>
            
            <staticText>
                <reportElement x="0" y="65" width="80" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[NIM]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="65" width="10" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="65" width="200" height="15"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{NIM}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="80" width="80" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Nama]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="80" width="10" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="80" width="200" height="15"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{NAMA}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="95" width="80" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Prodi]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="95" width="10" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="95" width="200" height="15"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{PRODI}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="40" height="25" backcolor="#C0C0C0"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="40" y="0" width="80" height="25" backcolor="#C0C0C0"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Kode MK]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="120" y="0" width="200" height="25" backcolor="#C0C0C0"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Mata Kuliah]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="320" y="0" width="50" height="25" backcolor="#C0C0C0"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[SKS]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="370" y="0" width="185" height="25" backcolor="#C0C0C0"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Dosen]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$V{ROW_NUM}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="80" height="20"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{kode_mk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="200" height="20"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{nama_mk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="50" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{sks}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="0" width="185" height="20"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{dosen}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="40">
            <staticText>
                <reportElement x="0" y="10" width="150" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total SKS Disetujui:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="10" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_SKS} == null ? 0 : $V{TOTAL_SKS}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
